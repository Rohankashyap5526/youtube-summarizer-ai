# Required: get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: only needed if YouTube blocks transcript requests from your
# server's IP (common on some cloud hosts). Leave blank otherwise.
# HTTP_PROXY_URL=http://user:pass@proxy-host:port
# HTTPS_PROXY_URL=http://user:pass@proxy-host:port
